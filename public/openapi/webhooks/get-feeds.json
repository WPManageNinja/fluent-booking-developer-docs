{
  "openapi": "3.0.4",
  "info": {
    "title": "FluentBooking Webhooks & SMS API",
    "version": "1.0.0",
    "description": "Outbound webhook configuration and SMS notification endpoints (Pro)."
  },
  "servers": [
    {
      "url": "https://your-site.test/wp-json/fluent-booking/v2",
      "description": "Replace with your own WordPress site."
    }
  ],
  "paths": {
    "/calendars/{id}/events/{event_id}/webhooks": {
      "get": {
        "operationId": "getFeeds",
        "summary": "Get Feeds",
        "tags": [
          "Webhooks & SMS"
        ],
        "description": "Handler: `WebhookController@getFeeds`. Source: `fluent-booking-pro/app/Http/Routes/api.php:69`.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Id path parameter."
          },
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Event Id path parameter."
          }
        ],
        "security": [
          {
            "ApplicationPasswords": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "webhooks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {}
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "per_page": {
                      "type": "integer"
                    },
                    "current_page": {
                      "type": "integer"
                    },
                    "last_page": {
                      "type": "integer"
                    },
                    "from": {
                      "type": "integer"
                    },
                    "to": {
                      "type": "integer"
                    }
                  }
                },
                "example": {
                  "webhooks": [
                    {},
                    {
                      "id": 2,
                      "slug": "sample-2"
                    }
                  ],
                  "total": 2,
                  "per_page": 20,
                  "current_page": 1,
                  "last_page": 1,
                  "from": 1,
                  "to": 2
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — invalid or missing credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": "rest_not_logged_in",
                  "message": "You are not currently logged in.",
                  "data": {
                    "status": 401
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — current user cannot perform this action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": "rest_forbidden",
                  "message": "Sorry, you are not allowed to do that.",
                  "data": {
                    "status": 403
                  }
                }
              }
            }
          },
          "404": {
            "description": "Resource not found.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": "not_found",
                  "message": "Resource not found.",
                  "data": {
                    "status": 404
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApplicationPasswords": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "WordPress Application Passwords — use Basic auth with username:application_password."
      }
    }
  }
