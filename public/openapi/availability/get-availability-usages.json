                    },
                    "last_page": {
                      "type": "integer"
                    },
                    "from": {
                      "type": "integer"
                    },
                    "to": {
                      "type": "integer"
                    }
                  }
                },
                "example": {
                  "availability_schedules": [
                    {
                      "id": 1,
                      "object_type": "calendar",
                      "object_id": 1,
                      "key": "sample_key",
                      "value": {},
